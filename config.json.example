{
  "owner": {
    "admin_number": "15551234567",           // Your Phone number (admin)
    "admin_number_formatted": "+15551234567",
    "aigentik_number": "15559876543",        // Public Google Voice number
    "aigentik_number_formatted": "+15559876543",
    "admin_email": "your@gmail.com"          // Your email — treated the same as admin_number for commands
  },
  "gmail": {
    "email": "your@gmail.com",
    "app_password": "xxxx xxxx xxxx xxxx",   // Gmail App Password (16 chars)
    "send_as": null,                         // Optional. A verified Gmail "Send mail as" alias
                                              // (Settings > Accounts > Send mail as) to use as the
                                              // From address on customer-facing mail instead of
                                              // `email` above — e.g. a business address like
                                              // contact@yourbusiness.com that forwards into this
                                              // inbox. Leave null to send as `email` directly.
    "imap_host": "imap.gmail.com",
    "imap_port": 993,
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 587
  },
  "llama": {
    "host": "http://127.0.0.1:8080",
    "model": "/data/data/com.termux/files/home/models/qwen3.5-4b-instruct/Qwen3.5-4B-Q4_K_M.gguf",
    "model_path": "~/models/qwen3.5-4b-instruct/Qwen3.5-4B-Q4_K_M.gguf",
    "llama_server_path": "/data/data/com.termux/files/home/llama.cpp/build/bin/llama-server",
    "context_size": 4096,
    "max_tokens": 512,
    "temperature": 0.7,
    "threads": 4
  },
  "llm": {
    "provider": "local"                      // "local" (default, on-device), "gemini" (Google AI
                                              // Studio, cloud), or "vertex" (Google Vertex AI /
                                              // Express Mode, cloud) — see "use gemini" / "use vertex" /
                                              // "use local" owner commands to switch at runtime
                                              // without restarting
  },
  "gemini": {
    "api_key": "",                           // A Google AI Studio key (aistudio.google.com/apikey) —
                                              // required only if llm.provider is/becomes "gemini".
                                              // NOT the same as a Vertex AI key below — AI Studio and
                                              // Vertex AI are different products with different key
                                              // formats (AI Studio keys start "AIzaSy...") even though
                                              // both serve Gemini models.
    "model": "gemini-2.0-flash",
    "host": "https://generativelanguage.googleapis.com/v1beta/openai"
  },
  "vertex": {
    "api_key": "",                           // A Vertex AI (Express Mode) API key from Cloud Console —
                                              // required only if llm.provider is/becomes "vertex". Keys
                                              // often start "AQ." and are bound to a service account;
                                              // this is a different Google product/API from "gemini"
                                              // above, with its own request format and quota.
    "model": "gemini-2.5-flash",             // 2.0/1.5-series models 404 under Express Mode even when
                                              // available on AI Studio — 2.5-flash is confirmed working
    "host": "https://aiplatform.googleapis.com/v1"
  },
  "sms": {
    "poll_interval_ms": 30000,
    "max_sms_fetch": 10
  },
  "behavior": {
    "paused": false,
    "pause_email": false,
    "pause_sms": false,
    "require_confirmation_for_destructive": true,
    "default_unmatched_action": "auto-reply",
    "default_unmatched_sms_action": "auto-reply",
    "tone_matching": true
  },
  "paths": {
    "data_dir": "/data/data/com.termux/files/home/Aigentik-CLI/data",
    "logs_dir": "/data/data/com.termux/files/home/Aigentik-CLI/data/logs",
    "conversations_dir": "/data/data/com.termux/files/home/Aigentik-CLI/data/conversations"
  }
}